# ═══════════════════════════════════════════════════════
#  ArithExam — Frontend Environment Variables (TEMPLATE)
#  ✅  This file IS committed to Git as a reference
#  📋  Copy this to .env and fill in your real values
# ═══════════════════════════════════════════════════════

# ── Backend API ──
VITE_API_BASE_URL=https://your-backend-domain.com/api

# ── Authentication ──
VITE_JWT_EXPIRY=15m
VITE_REFRESH_TOKEN_EXPIRY=7d

# ── Face Monitoring Service (Teammate's API) ──
VITE_FACE_MONITORING_WS_URL=wss://face-service.your-domain.com/ws
VITE_FACE_VERIFY_API_URL=https://face-service.your-domain.com/api/verify

# ── Question Generation Service (Ollama — Teammate's API) ──
VITE_OLLAMA_API_URL=https://ollama-service.your-domain.com/api/generate
VITE_OLLAMA_MODEL=llama3

# ── Email / OTP Service ──
VITE_OTP_API_URL=https://your-backend-domain.com/api/auth/send-otp

# ── File Storage ──
VITE_UPLOAD_API_URL=https://api.cloudinary.com/v1_1/your-cloud/image/upload
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ── App Configuration ──
VITE_APP_NAME=ArithExam
VITE_APP_VERSION=1.0.0
VITE_MAX_EXAM_VIOLATIONS=3
VITE_AUTOSAVE_INTERVAL_MS=60000
VITE_OTP_EXPIRY_SECONDS=300
VITE_OTP_RESEND_COOLDOWN_SECONDS=30
